# DeepSeek Harness 运行所需的环境变量。
# 使用方式：
#   cp .env.example .env
#   然后把下面占位符替换成真实值。

# 必填：DeepSeek API key（packages/llm/llm-deepseek/src/index.ts:45 DEFAULT_API_KEY_ENV）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 可选：自建网关 / 代理时覆盖 base URL（同一个文件 BASE_URL_ENV = 'DEEPSEEK_BASE_URL'）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
