.github
.agents
.claude
tsconfig*.tsbuildinfo
examples/**/node_modules
examples/**/lib
packages/**/node_modules
packages/**/lib
apps/**/node_modules
apps/**/lib
apps/**/dist
website
assets
*.log
.coverage
coverage
.worktrees
worktrees
.playwright-mcp
.humanize
